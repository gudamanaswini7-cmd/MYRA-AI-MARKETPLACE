{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "flask",
      "functions": {
        "app.py": {
          "includeFiles": "reelsly/static/videos/**"
        }
      }
    },
    "reelsly": {
      "root": "reelsly",
      "framework": "flask"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
